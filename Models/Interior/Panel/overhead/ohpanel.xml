<PropertyList>

  <path>ohpanel.ac</path>
  
 
   
     <animation>
        <type>pick</type>
        <object-name>instantlt.001</object-name>
        <action>
            <button>4</button>
            <repeatable>true</repeatable>
            <binding>
                <command>property-adjust</command>
                <property>controls/lighting/instrument-lights-norm</property>
                <step>0.1</step>
                <min>0</min>
                <max>1</max>
            </binding>
        </action>
    </animation>

    <animation>
        <type>pick</type>
        <object-name>instantlt.001</object-name>
        <action>
            <button>3</button>
            <repeatable>true</repeatable>
            <binding>
                <command>property-adjust</command>
                <property>controls/lighting/instrument-lights-norm</property>
                <step>-0.1</step>
                <min>0</min>
                <max>1</max>
            </binding>
        </action>
    </animation>
	
	 <animation>
        <type>rotate</type>
        <object-name>instantlt.001</object-name>
        <property>controls/lighting/instrument-lights-norm</property>
        <factor>200</factor>
      <axis>
        <x> 0 </x>
        <y> 0 </y>
        <z> -1 </z>
      </axis>
      <center>
        <x-m> 0.16 </x-m>
        <y-m> 0 </y-m>
        <z-m> 0 </z-m>  
      </center>
    </animation>
   

