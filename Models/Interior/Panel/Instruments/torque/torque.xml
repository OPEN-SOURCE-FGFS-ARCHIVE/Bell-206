<?xml version="1.0"?>

<PropertyList>
	<path>torque.ac</path>
	
	 <effect>
        <inherits-from>Effects/model-transparent</inherits-from>
    <condition>
      <property>sim/rendering/rembrandt/enabled</property>
    </condition>
       
	<object-name>Face</object-name>
  
    </effect> 

	
	
	<animation>
		<type>rotate</type>
		<object-name>Lneedle</object-name>
		<property>sim/model/bo105/torque-pct</property>
		<interpolation>
			<entry><ind>0</ind><dep>-205</dep></entry>
			<entry><ind>60</ind><dep>-90</dep></entry>
			<entry><ind>120</ind><dep>25</dep></entry>
		</interpolation>
		<axis>
			<x>-1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>Rneedle</object-name>
		<property>sim/model/bo105/torque-pct</property>
		<interpolation>
			<entry><ind>0</ind><dep>-205</dep></entry>
			<entry><ind>60</ind><dep>-90</dep></entry>
			<entry><ind>120</ind><dep>25</dep></entry>
		</interpolation>
		<axis>
			<x>-1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>
	
	 <animation>
    <type>material</type>
    <object-name>Rneedle</object-name>
   <object-name>Lneedle</object-name>
  
   <object-name>Face</object-name>
  <emission>
     <factor-prop>controls/lighting/instrument-lights-norm</factor-prop>
      <red>   0.0 </red>
      <green> 0.7 </green>
      <blue>  0.0 </blue>
    </emission>
   
  </animation>
</PropertyList>
