<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <path>oilpressure.ac</path>

  <animation>
    
    <object-name>face</object-name>
    <object-name>needle</object-name>

   
  </animation>

 

  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>needle</object-name>
     <emission>
     <factor-prop>controls/lighting/instrument-lights-norm</factor-prop>
      <red>   0.0 </red>
      <green> 0.7 </green>
      <blue>  0.0 </blue>
    </emission>
   
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>needle</object-name>
    <property>/rotors/gear/mgb-oil-pressure-bar</property>
   	<factor>36</factor>
		<center>   
		  <x-m> 0 </x-m> 
		  <y-m>0 </y-m>
			<z-m>0 </z-m>
		</center>
		<axis>
		  <x>-1</x>
		  <y>0</y>
		  <z>0</z>
		</axis>
  </animation>

</PropertyList>


