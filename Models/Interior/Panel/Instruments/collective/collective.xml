<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <path>collective.ac</path>
	
  <animation>
    <object-name>throttle</object-name>
    <object-name>idlerelease</object-name>
    <object-name>starter</object-name>
    <object-name>collts</object-name>
    <object-name>collgov</object-name>
  </animation>

  <animation>
    <name>CollectiveComplet</name>
    <object-name>throttle</object-name>
    <object-name>idlerelease</object-name>
    <object-name>starter</object-name>
    <object-name>collts</object-name>
    <object-name>collgov</object-name>
		<object-name>Landing lights</object-name>
	<object-name>starter</object-name>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>CollectiveComplet</object-name>
    <property>controls/engines/engine[0]/throttle</property>
      <factor> -12</factor>
    <offsets>
      <x-m>  0.145 </x-m>
      <y-m>  0.000 </y-m>
      <z-m> -0.003 </z-m>
    </offsets>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>
  
    <model>
		<name>Landing lights</name>
    <path>Aircraft/bell-206/Models/Interior/Panel/Instruments/switches/landing-lights.xml</path>
    <offsets> 
    <x-m>-0.268</x-m>
   <y-m>-0.01</y-m>
   <z-m>0.019</z-m>
   <pitch-deg>-87</pitch-deg>

    </offsets>
	
	</model>
	
	<animation>
    <type>select</type>
    <object-name>NoseGearLandinglight</object-name>
    <object-name>Taxi-Light-Left</object-name>
         
    <condition>
      <equals>
        <property>controls/switches/landing-lights-switch</property>
        <value> 1 </value>
      </equals>
    </condition>
  </animation> 	
  
   <model>
		<name>starter</name>
    <path>Aircraft/bell-206/Models/Interior/Panel/Instruments/Switch/starter.xml</path>
    <offsets> 
    <x-m>-0.24</x-m>
   <y-m>0.00</y-m>
   <z-m>0.021</z-m>
   <pitch-deg>-87</pitch-deg>

    </offsets>
	
	</model>

</PropertyList>

