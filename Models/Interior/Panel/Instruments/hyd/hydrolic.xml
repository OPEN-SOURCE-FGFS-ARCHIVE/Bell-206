<?xml version="1.0" ?>

<PropertyList>
    <path>hydrolic.ac</path>

    <animation>
        <type>range</type>
        <min-m>0</min-m>
        <max-m>10</max-m>
    </animation>
    
	
	<!-- Hydrolic switch -->
	
		<model>
		
		<path>Aircraft/bell-206/Models/Interior/Panel/Instruments/switches/hyd.xml</path>
		<offsets>
			<x-m>-0.001</x-m>
			<y-m>0.0091</y-m>
			<z-m>0.0046</z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
		<overlay>
		 <animation n="100">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>0.3</y-offset>
    <z-offset>1</z-offset>
   </animation>
  </overlay>
	</model>

	
		<!-- engine de icing -->
	
		<model>
		
		<path>Aircraft/bell-206/Models/Interior/Panel/Instruments/switches/eng-ice.xml</path>
		<offsets>
			<x-m>-0.001</x-m>
			<y-m>0.00</y-m>
			<z-m>0.0046</z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
		<overlay>
		 <animation n="100">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>0.3</y-offset>
    <z-offset>1</z-offset>
   </animation>
  </overlay>
	</model>

	
	
		<!-- dim caution lights ( not implemented ) -->
	
		<model>
		
		<path>Aircraft/bell-206/Models/Interior/Panel/Instruments/switches/spare.xml</path>
		<offsets>
			<x-m>-0.001</x-m>
			<y-m>-0.0091</y-m>
			<z-m>0.0046</z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
		<overlay>
		 <animation n="100">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>0.3</y-offset>
    <z-offset>1</z-offset>
   </animation>
  </overlay>
	</model>
</PropertyList>
